root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false # two trailing spaces are a hard line break

[*.cs]
# Style the codebase already follows — see CLAUDE.md. Kept at suggestion severity so `dotnet build`
# stays warning-free; these are editor hints, not a gate.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Nullable reference types are on; surface the ones that actually bite at build time.
dotnet_diagnostic.CS8600.severity = warning # converting null literal to non-nullable type
dotnet_diagnostic.CS8602.severity = warning # dereference of a possibly null reference
dotnet_diagnostic.CS8618.severity = warning # non-nullable field uninitialized
